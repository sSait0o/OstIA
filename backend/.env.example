# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200
CORS_EXTRA_ORIGINS=

# Database (local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ostia_user
DB_PASSWORD=ostia_secret
DB_NAME=ostia
# Database (Railway production - remplace les variables ci-dessus)
# DATABASE_URL=postgresql://user:password@host:port/db
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Encryption (AES-256-GCM for sensitive data at rest: email, name, CV, OAuth tokens, application notes/emails)
# Required. 32-byte key, encoded as 64 hex characters or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Resend (transactional emails - account verification, etc.)
RESEND_API_KEY=
MAIL_FROM=OstIA <no-reply@ostia-app.com>

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email/google/callback

# Microsoft OAuth (Outlook)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/email/microsoft/callback
MICROSOFT_TENANT_ID=common

# Python core service
CORE_API_URL=http://localhost:8001

# Optional: cap emails processed per sync (utile en local pour éviter les gros syncs, ne pas définir en prod)
EMAIL_SYNC_MAX_MESSAGES=

# France Travail API
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
