# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# Database (local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ostia_user
DB_PASSWORD=ostia_secret
DB_NAME=ostia
# Database (Railway production — remplace les variables ci-dessus)
# DATABASE_URL=postgresql://user:password@host:port/db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email/google/callback

# Microsoft OAuth (Outlook)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/email/microsoft/callback
MICROSOFT_TENANT_ID=common

# Python core service
CORE_API_URL=http://localhost:8001

# France Travail API
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
