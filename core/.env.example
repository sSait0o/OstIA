# Groq (LLM provider)
GROQ_API_KEY=
# Optional: multiple keys separated by commas, rotated automatically (falls back to GROQ_API_KEY if empty)
GROQ_API_KEYS=

# Tavily (web search fallback for geocoding, free tier: https://app.tavily.com)
TAVILY_API_KEY=

# CORS: JSON array of allowed frontend origins (defaults to ["http://localhost:4200"] if unset)
ALLOWED_ORIGINS=["http://localhost:4200"]
